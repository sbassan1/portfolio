---

<div class="tech-stack-container">
	<h2 class="tech-stack-title">My Tech Stack</h2>
	<div class="tech-grid">
		{technologies.map((tech) => (
			<div class="tech-item" style={`--brand-color: ${tech.color}`}>
				<div class="icon-wrapper" set:html={tech.icon} />
				<span class="tech-name">{tech.name}</span>
			</div>
		))}
	</div>
</div>

<style>
	.tech-stack-container {
		margin-top: 4rem;
	}

	.tech-stack-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 2rem;
		color: hsl(var(--text-main));
		text-align: center;
	}

	.tech-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
		padding: 2.5rem;
		border-radius: 24px;
		border: 1px solid hsl(var(--accent) / 0.4);
		box-shadow: 0 20px 40px -10px hsl(var(--accent) / 0.1);
	}

	.tech-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		padding: 1.5rem;
		background: hsl(var(--bg-secondary) / 0.5);
		border: 1px solid hsl(var(--bg-secondary));
		border-radius: 20px;
		width: 100%;
		max-width: 140px;
		flex: 1 1 120px;
		transition: var(--transition-base);
		cursor: default;
	}

	.tech-item:hover {
		transform: translateY(-8px) scale(1.05);
		background: hsl(var(--bg-secondary));
		border-color: var(--brand-color);
		box-shadow: 0 10px 30px -10px var(--brand-color);
	}

	.icon-wrapper {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: var(--transition-base);
	}

	.tech-item:hover .icon-wrapper {
		transform: scale(1.1);
	}

	:global(.tech-item svg) {
		width: 100%;
		height: 100%;
		fill: hsl(var(--text-muted));
		transition: var(--transition-base);
	}

	.tech-item:hover :global(svg) {
		fill: var(--brand-color);
	}

	.tech-name {
		font-size: 0.85rem;
		font-weight: 600;
		color: hsl(var(--text-muted));
		transition: var(--transition-base);
	}

	.tech-item:hover .tech-name {
		color: hsl(var(--text-main));
	}

	@media (max-width: 640px) {
		.tech-grid {
			gap: 1rem;
		}
		
		.tech-item {
			padding: 1rem;
			flex-basis: 100px;
		}
	}
</style>
