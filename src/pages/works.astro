---
import BaseLayout from "../layouts/BaseLayout.astro"
import ProjectCard from "../components/ProjectCard.astro"
import "../styles/works.css";

import ecommerceImg from "../../public/assets/work-images/E-Commerce1.png";
import todoImg from "../../public/assets/work-images/TODO app1.png";
import battleshipImg from "../../public/assets/work-images/BattleShip1.png";
import catanImg from "../../public/assets/work-images/Catan1.png";

const projects = [
  {
    title: "E-Commerce Platform",
    description: "A full-stack e-commerce solution with real-time inventory management system, with a CRUD and user/admin mode.",
    image: ecommerceImg.src,
    tags: ["Bootstrap", "Node.js", "PostgreSQL", "ExpressJS"],
    link:"https://gitmasters-ids-1c-2025-1-front.onrender.com/html/user/index.html"
  },
  {
    title: "TODO App",
    description: "An elegant little webapp to manage daily tasks and reminders, utilizing LocalStorage to store tasks and tiers of priority.",
    image: todoImg.src,
    tags: ["HTML5", "CSS5", "JavaScript", "LocalStorage"],
    link:"https://sbassan1.github.io/todo-list/"
  },
  {
    title: "BattleShip Browser Game",
    description: "A fully featured copy of the beloved board game, BattleShip.",
    image: battleshipImg.src,
    tags: ["HTML5", "BulmaCSS", "JavaScript"],
    link:"https://sbassan1.github.io/battleshipClone/"
  },
  {
    title: "Catan Java Desktop App",
    description: "A fully featured copy of the beloved board game, Catan. Made using JavaFX.",
    image: catanImg.src,
    tags: ["Maven", "JavaFX", "Object Oriented Programming"],
    link:"https://github.com/sbassan1/tp2_catan"
  }
];
---

<BaseLayout title="Santiago Bassani | Work">
    <section class="section-container">
        <h1 class="hero-title">Some of my projects</h1>
        <p class="hero-intro">Here are some of the projects I've done, <span style="color: hsl(var(--accent));">(not&nbsp;counting&nbsp;comissions)</span> Hope you enjoy them!</p>
        
        <div class="project-grid">
            {projects.map((project) => (
                <ProjectCard {...project} />
            ))}
        </div>
    </section>
</BaseLayout>
