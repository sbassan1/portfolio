---
import BaseLayout from "../layouts/BaseLayout.astro"
import "../styles/contact.css";
---

<BaseLayout title="Santiago Bassani | Contact">

    <section class="section-container">
        <h1 class="hero-title">Get in touch</h1>
        <p class="hero-intro">
            Looking to work on a project together or just want to say hi? 
            Feel free to reach out through any of the channels below, I will get back to you as soon as possible!
        </p>

        <div class="contact-list">
            <div class="contact-item stagger-1">
                <span class="contact-label">Email</span>
                <a href="mailto:santiagobassani2000@gmail.com" class="contact-link">santiagobassani2000@gmail.com</a>
            </div>
            
            <div class="contact-item stagger-2">
                <span class="contact-label">Phone</span>
                <a href="tel:+5491136039130" class="contact-link">+54 9 11 3603-9130</a>
            </div>
            
            <div class="contact-item stagger-3">
                <span class="contact-label">LinkedIn</span>
                <a href="https://www.linkedin.com/in/santiago-martin-bassani-russo/" target="_blank" rel="noopener noreferrer" class="contact-link">linkedin.com/in/santiago-martin-bassani-russo/</a>
            </div>
            
            <div class="contact-item stagger-4">
                <span class="contact-label">GitHub</span>
                <a href="https://github.com/sbassan1" target="_blank" rel="noopener noreferrer" class="contact-link">@sbassan1</a>
